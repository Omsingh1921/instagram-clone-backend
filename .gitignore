# ============================================================
# BACKEND .gitignore
# ============================================================

# Maven build output
target/

# Local media upload storage — NEVER commit binary uploads.
# Cloudinary is used in production; local uploads are dev-only.
uploads/

# JVM crash & replay logs (generated by the JVM on crashes)
hs_err_pid*.log
replay_pid*.log

# Environment secrets — must never be committed
.env
.env.local
.env.production

# IDE files
.idea/
*.iml
.classpath
.project
.settings/

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# ============================================================
# INSTAGRAM CLONE — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# Copy this file to .env and provide your production or local credentials.
# Never commit the .env file containing real secrets to version control.

# --- SERVER & PROFILE CONFIGURATION ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- PRODUCTION / DEV DATABASE (MYSQL) ---
# Option A: Full JDBC URL (Recommended for AWS RDS, PlanetScale, Cloud SQL, etc.)
DB_URL=jdbc:mysql://localhost:3306/instagram_clone_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Option B: Individual connection components (Used if DB_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=instagram_clone_db

# Database Authentication
DB_USERNAME=root
DB_PASSWORD=Root@123

# --- REDIS DISTRIBUTED CACHE & RATE LIMITING ---
# Host and port of the active Redis instance
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave blank if Redis does not require a password (e.g., local development or VPC-isolated instance)
REDIS_PASSWORD=

# --- APACHE KAFKA (SUPPORTS SINGLE & MULTI-NODE CLUSTERS) ---
# Single broker: localhost:9092
# Multi-node cluster: broker1:9092,broker2:9092,broker3:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=instagram-clone-group
# Concurrency level for parallel partition consumption across brokers
KAFKA_LISTENER_CONCURRENCY=3
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=5000

# --- CLOUDINARY MEDIA STORAGE & CDN ---
# Provide your Cloudinary credentials from https://cloudinary.com/console
# When provided, assets are automatically uploaded, transformed, and delivered via Cloudinary.
# If omitted or left as placeholders, the backend safely falls back to local storage (/uploads).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FALLBACK_ON_FAILURE=true
CLOUDINARY_MAX_RETRIES=2
CLOUDINARY_RETRY_BACKOFF_MS=500

# --- SECURITY & JWT SESSIONS ---
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# --- LOCAL UPLOAD STORAGE FALLBACK DIRECTORY ---
APP_UPLOAD_DIR=uploads

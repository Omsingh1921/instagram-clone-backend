# ============================================================
# INSTAGRAM CLONE — ACTIVE LOCAL/PRODUCTION ENVIRONMENT CONFIG
# ============================================================
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- DATABASE (MYSQL) ---
DB_URL=jdbc:mysql://localhost:3306/instagram_clone_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_HOST=localhost
DB_PORT=3306
DB_NAME=instagram_clone_db
DB_USERNAME=root
DB_PASSWORD=Root@123

# --- REDIS (ACTIVE ON 127.0.0.1:6379) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- APACHE KAFKA (SUPPORTS SINGLE OR MULTI-NODE BROKERS) ---
# Example for multi-node: broker1:9092,broker2:9092,broker3:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=instagram-clone-group
KAFKA_LISTENER_CONCURRENCY=3
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_REQUEST_TIMEOUT_MS=5000

# --- CLOUDINARY CREDENTIALS (PASTE YOUR KEYS HERE) ---
# Sign up / Login at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FALLBACK_ON_FAILURE=true

